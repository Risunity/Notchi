<Window x:Class="WindowsNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="344" Height="496"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" ShowActivated="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Custom Minimalist Dark ScrollBar -->
        <Style x:Key="MinimalScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#38383E" CornerRadius="2"
                                HorizontalAlignment="Center" Width="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#555562"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#3D7EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MinimalScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button -->
        <Style x:Key="SettingsTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D0D0D6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language Pill Radio -->
        <Style x:Key="SettingsLanguageOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D0D0D6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D7EFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="34" Height="19"
                                CornerRadius="9.5" Background="#2C2C32" BorderBrush="#383840" BorderThickness="1">
                            <Border x:Name="Thumb" Width="13" Height="13"
                                    CornerRadius="6.5" Background="#FFFFFF"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#4C4C56"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3D7EFF"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="13" Height="13" CornerRadius="6.5" Background="#FFFFFF"
                                BorderBrush="#15000000" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18">
                            <Border Height="4" CornerRadius="2" Background="#28282D" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#3D7EFF" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action / Primary Button -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3D7EFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F8CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D6EEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333338"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="9,4.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E34"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#44444C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#4A2222"/>
            <Setter Property="Background" Value="#281616"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#381D1D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5C2B2B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#201111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings TextBox -->
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#151518"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C2C32"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="CaretBrush" Value="#3D7EFF"/>
            <Setter Property="SelectionBrush" Value="#3D7EFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A42"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7EFF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#18181C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card Shell with Soft Obsidian Glow -->
    <Border x:Name="CardBorder" Background="#141416" BorderBrush="#28282E" BorderThickness="1"
            CornerRadius="16" Padding="15,13">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Tabs -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid x:Name="HeaderRow" Grid.Row="0" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                        <Path Data="M1,3.5 H13 M1,7.5 H13 M1,11.5 H13 M4.5,1.5 V5.5 M9.5,5.5 V9.5 M5.5,9.5 V13.5"
                              Stroke="#8E8E93" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource SettingsTitle}" Foreground="#F5F5F7"
                               FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Saved}"
                               Foreground="#6E6E73" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Width="22" Height="22"
                            Style="{DynamicResource CloseButton}" Background="Transparent" BorderThickness="0"
                            Content="&#x2715;" FontSize="9.5"
                            Foreground="#8E8E93"/>
                </StackPanel>
            </Grid>

            <!-- 2. Segmented Navigation Tabs -->
            <Border Grid.Row="1" Background="#1A1A1E" BorderBrush="#25252A" BorderThickness="1"
                    CornerRadius="9" Padding="2.5" Margin="0,11,0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="GeneralTabRadio" Grid.Column="0"
                                 GroupName="SettingsTabs" IsChecked="True"
                                 Content="Umum"
                                 Style="{StaticResource SettingsTabRadio}"/>
                    <RadioButton x:Name="MobileTabRadio" Grid.Column="1"
                                 GroupName="SettingsTabs"
                                 Content="Notchi Mobile"
                                 Style="{StaticResource SettingsTabRadio}"/>
                    <RadioButton x:Name="RewardTabRadio" Grid.Column="2"
                                 GroupName="SettingsTabs"
                                 Content="{DynamicResource RewardTab}"
                                 Style="{StaticResource SettingsTabRadio}"/>
                </Grid>
            </Border>

            <!-- 3. Tab Contents -->
            <Grid Grid.Row="2">
                <!-- TAB 1: UMUM (General) -->
                <ScrollViewer x:Name="GeneralTabContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Group 1: Sistem -->
                        <TextBlock Text="{DynamicResource System}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StartupTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource StartupDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                          Style="{StaticResource SettingsToggle}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Group: Volume -->
                        <TextBlock Text="{DynamicResource VolumeSection}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource VolumeTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource VolumeDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="MuteToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50"
                                            VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                                    <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="50%"
                                               Foreground="#8E8E93" FontSize="9.5" FontFamily="Consolas"
                                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="30"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Bahasa -->
                        <TextBlock Text="{DynamicResource LanguageSection}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bahasa Tampilan" Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="Pilih bahasa antarmuka" Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#141417" BorderBrush="#25252A" BorderThickness="1"
                                        CornerRadius="7" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="IndonesianOption"
                                                     GroupName="Language"
                                                     Content="{DynamicResource LanguageIndonesian}"
                                                     Style="{StaticResource SettingsLanguageOption}"/>
                                        <RadioButton x:Name="EnglishOption"
                                                     GroupName="Language"
                                                     Content="{DynamicResource LanguageEnglish}"
                                                     Style="{StaticResource SettingsLanguageOption}"
                                                     Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Group 3: Pintasan -->
                        <TextBlock Text="{DynamicResource HotkeySection}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource HotkeyTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource HotkeyDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="HotkeyRecorder" Grid.Column="1"
                                        Background="#141417" CornerRadius="6"
                                        Padding="10,5" VerticalAlignment="Center" Cursor="Hand"
                                        MinWidth="88" BorderThickness="1"
                                        BorderBrush="#2C2C32">
                                    <TextBlock x:Name="HotkeyLabel"
                                               Foreground="#F5F5F7" FontSize="10"
                                               HorizontalAlignment="Center"
                                               FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Group 4: Fokus Media -->
                        <TextBlock Text="{DynamicResource FocusSection}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,2,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusHotkeyTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusHotkeyDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="FocusHotkeyRecorder" Grid.Column="1"
                                            Background="#141417" CornerRadius="6"
                                            Padding="10,5" VerticalAlignment="Center" Cursor="Hand"
                                            MinWidth="88" BorderThickness="1"
                                            BorderBrush="#2C2C32">
                                        <TextBlock x:Name="FocusHotkeyLabel"
                                                   Foreground="#F5F5F7" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#24242A" Margin="0,9"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusLyricsTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusLyricsDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EnableLyricsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#24242A" Margin="0,9"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FocusHideNotchTitle}"
                                                   Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource FocusHideNotchDescription}"
                                                   Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="HideNotchToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: NOTCHI MOBILE -->
                <ScrollViewer x:Name="MobileTabContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Group 1: Server Status & Switch -->
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource MobileServerTitle}"
                                               Foreground="#F5F5F7" FontSize="11" FontWeight="Medium"/>
                                    <TextBlock Text="{DynamicResource MobileServerDescription}"
                                               Foreground="#8E8E93" FontSize="8.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="MobileServerToggle" Grid.Column="1"
                                          Style="{StaticResource SettingsToggle}"
                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Group 2: Port & File Limit -->
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource MobilePort}" Foreground="#8E8E93" FontSize="8.5" FontWeight="SemiBold"/>
                                    <TextBox x:Name="MobilePortBox" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource MobileMaxFileSize}" Foreground="#8E8E93" FontSize="8.5" FontWeight="SemiBold"/>
                                    <TextBox x:Name="MobileMaxFileSizeBox" Style="{StaticResource SettingsTextBox}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Button: Pasangkan Perangkat -->
                        <Button x:Name="PairDeviceButton"
                                Style="{StaticResource PrimaryActionButton}"
                                Margin="0,0,0,12" Height="34">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x25A3;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource PairNewDevice}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Group 3: Daftar Perangkat Terhubung -->
                        <TextBlock Text="{DynamicResource PairedDevices}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>

                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="NoDevicesLabel" Text="{DynamicResource NoPairedDevices}"
                                           Foreground="#8E8E93" FontSize="9" FontStyle="Italic"
                                           HorizontalAlignment="Center" Margin="0,8,0,8"/>

                                <ItemsControl x:Name="DevicesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#151518" BorderBrush="#24242A" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,7" Margin="0,2.5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeviceName}" Foreground="#F5F5F7" FontSize="10.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding LastSeen, StringFormat='Terakhir aktif: {0:HH:mm dd/MM}'}"
                                                                   Foreground="#85858D" FontSize="8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{DynamicResource Revoke}"
                                                            Style="{StaticResource DangerActionButton}"
                                                            Tag="{Binding DeviceId}"
                                                            Click="OnRevokeDeviceClick"
                                                            Padding="8,3.5" FontSize="9"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 3: REWARD -->
                <ScrollViewer x:Name="RewardTabContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Group 1: Klaim Reward -->
                        <TextBlock Text="{DynamicResource RewardTitle}" Foreground="#73737A"
                                   FontSize="8.5" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Border Background="#1C1C20" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="10" Padding="12,11" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RewardDescription}"
                                           Foreground="#8E8E93" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RewardCodeInput" Style="{StaticResource SettingsTextBox}"
                                             FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <Button x:Name="RedeemButton" Grid.Column="1"
                                            Content="{DynamicResource Redeem}"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Padding="14,6" FontSize="10.5"
                                            VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="RewardStatusText"
                                           Text="" Foreground="#85858D"
                                           FontSize="9" TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Status Reward Aktif -->
                        <Border x:Name="ActiveRewardPanel" Background="#18181C" BorderBrush="#25252B" BorderThickness="1"
                                CornerRadius="14" Padding="14,13" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel>
                                <!-- Compact Background Banner (Notch Capsule) -->
                                <Border x:Name="ActiveRewardCompactHost" Height="52" CornerRadius="12"
                                        Background="#040405" BorderBrush="#26262E" BorderThickness="1"
                                        ClipToBounds="True" Margin="0,0,0,12">
                                    <Grid>
                                        <Image x:Name="ActiveRewardCompactImage" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Name & Number Row -->
                                <Grid Margin="2,0,2,10">
                                    <TextBlock x:Name="ActiveRewardBadgeText" Text="Nightmare Cloud"
                                               Foreground="#F5F5F7" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ActiveRewardClaimNumberText" Text="#001"
                                               Foreground="#F5F5F7" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="ActiveRewardRarityText" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Toggle Gunakan Background Row -->
                                <Grid Margin="2,0,2,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource RewardUseBgTitle}" Foreground="#F5F5F7"
                                                   FontSize="11" FontWeight="Medium"/>
                                        <TextBlock Text="{DynamicResource RewardUseBgDescription}" Foreground="#8E8E93"
                                                   FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="UseRewardBgToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggle}"
                                              VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Thin Separator -->
                                <Border Height="1" Background="#26262C" Margin="0,0,0,12"/>

                                <!-- Tombol Lepas Perangkat (Aligned Right) -->
                                <Grid>
                                    <Button x:Name="ReleaseDeviceButton"
                                            Content="{DynamicResource ReleaseDevice}"
                                            Style="{StaticResource DangerActionButton}"
                                            HorizontalAlignment="Right" Padding="12,5" FontSize="9.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
